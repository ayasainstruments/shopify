<!-- ============ ORDER FORM ============ -->
<section class="section full-width" id="order">
  <div class="section-head reveal">
    <p class="kicker">Start an order</p>
    <h2>Tell us what you're building.</h2>
    <p class="section-sub">Send your details and we'll come back with a quote, shipping costs and current batch availability. You can also write directly to <a href="mailto:makers@ayasainstruments.com">makers@ayasainstruments.com</a>.</p>
  </div>
  <form class="order-form reveal" id="orderForm">
    <div class="form-row">
      <div>
        <label for="of-name">Name *</label>
        <input id="of-name" name="name" type="text" required autocomplete="name">
      </div>
      <div>
        <label for="of-email">Email *</label>
        <input id="of-email" name="email" type="email" required autocomplete="email">
      </div>
    </div>
    <div class="form-row">
      <div>
        <label for="of-company">Company</label>
        <input id="of-company" name="company" type="text" autocomplete="organization">
      </div>
      <div>
        <label for="of-country">Country *</label>
        <input id="of-country" name="country" type="text" required autocomplete="country-name">
      </div>
    </div>
    <fieldset>
      <legend>I'm interested in</legend>
      <div class="check-row">
        <label><input type="checkbox" name="interest" value="Ember Steel shells"> Ember Steel®</label>
        <label><input type="checkbox" name="interest" value="AISI 430 shells"> AISI 430</label>
        <label><input type="checkbox" name="interest" value="DC04 raw shells"> DC04 raw</label>
        <label><input type="checkbox" name="interest" value="DC04 nitrided shells"> DC04 nitrided</label>
        <label><input type="checkbox" name="interest" value="Tools &amp; supplies"> Tools &amp; supplies</label>
      </div>
    </fieldset>
    <div class="form-row">
      <div>
        <label for="of-qty">Estimated quantity</label>
        <input id="of-qty" name="quantity" type="text" placeholder="e.g. 22 tops + 22 bottoms">
      </div>
      <div>
        <label for="of-vat">VAT number (EU businesses)</label>
        <input id="of-vat" name="vat" type="text" placeholder="optional">
      </div>
    </div>
    <label for="of-msg">Message</label>
    <textarea id="of-msg" name="message" placeholder="Anything we should know — timeline, delivery address, batch preferences…"></textarea>
    <label class="consent" style="display:flex;">
      <input type="checkbox" name="newsletter" value="yes">
      <span>Subscribe me to the maker newsletter — only a few emails a year, about new batches and material updates.</span>
    </label>
    <button type="submit" class="btn btn-primary">Send order request</button>
    <p class="form-fine" id="formFine">Sending opens your email app with the request pre-filled, addressed to makers@ayasainstruments.com.</p>
  </form>
</section>

<script>
  // Order form → pre-filled email to the Maker Shop (interim flow until the Odoo webstore)
  document.getElementById("orderForm").addEventListener("submit", e => {
    e.preventDefault();
    const f = e.target;
    const interests = [...f.querySelectorAll('input[name="interest"]:checked')].map(c => c.value).join(", ") || "—";
    const body = [
      `Name: ${f.name.value}`,
      `Email: ${f.email.value}`,
      `Company: ${f.company.value || "—"}`,
      `Country: ${f.country.value}`,
      `VAT number: ${f.vat.value || "—"}`,
      `Interested in: ${interests}`,
      `Estimated quantity: ${f.quantity.value || "—"}`,
      `Newsletter: ${f.newsletter.checked ? "yes" : "no"}`,
      "",
      f.message.value
    ].join("\n");
    location.href = "mailto:makers@ayasainstruments.com"
      + "?subject=" + encodeURIComponent(`Maker Shop order request — ${f.name.value}`)
      + "&body=" + encodeURIComponent(body);
    document.getElementById("formFine").textContent = "Your email app should have opened with the request — just hit send there.";
  });
</script>

{% stylesheet %}
  /* ---------- maker shop page ---------- */
  .makers-hero {
    position: relative; min-height: 72svh; display: grid; place-items: center; text-align: center;
    border-bottom: 1px solid var(--line); padding: 7.5rem 1.5rem 4.5rem; overflow: hidden;
  }
  .makers-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }
  .makers-hero-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(13,14,17,0.72) 0%, rgba(13,14,17,0.55) 45%, rgba(13,14,17,0.94) 100%); }
  .makers-hero-inner { position: relative; max-width: 820px; }
  .makers-hero::after {
    content: ""; position: absolute; left: 50%; bottom: 0; transform: translateX(-50%);
    width: min(560px, 80vw); height: 3px; background: var(--anneal); border-radius: 3px 3px 0 0;
  }
  .makers-hero .hero-sub { max-width: 620px; margin: 1.6rem auto 2.4rem; color: var(--muted); font-size: 1.05rem; }
  .photo-tile { background: var(--bg-2); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; margin: 0; }
  .photo-tile img { display: block; width: 100%; height: auto; }
  .photo-tile figcaption { background: var(--bg-2); color: var(--muted); font-size: 0.8rem; letter-spacing: 0.06em; padding: 0.7rem 1rem; border-top: 1px solid var(--line); }
  .detail-strip { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.1rem; margin-top: 2.4rem; }
  .detail-strip figure { margin: 0; }
  .detail-strip img { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 14px; border: 1px solid var(--line); filter: brightness(0.82) saturate(0.9) contrast(1.04); }
  .detail-strip figcaption { margin-top: 0.55rem; font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--brand-light); }

  .steel { border: 1px solid var(--line); border-radius: 20px; background: var(--bg-2); padding: clamp(1.6rem, 4vw, 2.8rem); margin-bottom: 1.6rem; }
  .steel-signature { background: linear-gradient(180deg, var(--bg-3), var(--bg-2)); }
  .steel-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 1.2rem; margin-bottom: 0.4rem; }
  .steel-head h3 { font-size: clamp(1.5rem, 2.6vw, 2rem); }
  .steel-tag { font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--brand-light); }
  .steel-band { height: 3px; width: 130px; background: var(--anneal); border-radius: 3px; margin: 0.6rem 0 1.4rem; }
  .steel-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(1.6rem, 4vw, 3.5rem); align-items: start; }
  .steel-text p { margin-bottom: 1.1rem; color: #c9c6be; font-size: 0.98rem; }
  .steel-note { color: var(--muted); font-size: 0.85rem; margin-top: 0.9rem; }
  .steel-note strong { color: var(--brand-light); font-weight: 500; }
  .steel-photo { margin-top: 1.8rem; }
  .shell-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; margin-top: 1.2rem; }

  table.price-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .price-table caption { caption-side: top; text-align: left; font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--brand-light); padding-bottom: 0.7rem; font-weight: 500; }
  .price-table th, .price-table td { padding: 0.55rem 0.7rem; border-bottom: 1px solid var(--line); text-align: left; }
  .price-table th { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); font-weight: 500; }
  .price-table td:nth-child(n+2), .price-table th:nth-child(n+2) { text-align: right; font-variant-numeric: tabular-nums; }
  .price-table td { color: var(--ink); }
  .price-table td:first-child { color: #c9c6be; }
  .price-table tr:last-child td { border-bottom: 0; }

  .dc04-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; align-items: center; }
  .dc04-strip img { width: 100%; height: auto; display: block; }
  .dc04-strip-wrap { margin: 0; }
  .dc04-strip-wrap figcaption { margin-top: 0.55rem; font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--brand-light); }

  .geometry-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 16px; background: var(--bg-2); margin-top: 2.4rem; }
  table.geometry { width: 100%; min-width: 560px; border-collapse: collapse; font-size: 0.92rem; }
  .geometry th, .geometry td { padding: 0.75rem 1.2rem; border-bottom: 1px solid var(--line); text-align: right; font-variant-numeric: tabular-nums; }
  .geometry th { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand-light); font-weight: 500; }
  .geometry th:first-child, .geometry td:first-child { text-align: left; color: #c9c6be; }
  .geometry tr:last-child td { border-bottom: 0; }
  .geometry td { color: var(--ink); }

  .tools-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 1.1rem; }
  .tool-photo { background: #fff; border: 1px solid var(--line); border-radius: 10px; margin-bottom: 1rem; display: grid; place-items: center; height: 150px; padding: 0.5rem; overflow: hidden; }
  .tool-photo img { max-width: 100%; max-height: 100%; width: auto; height: auto; }
  .tool-price { display: block; margin-top: 0.7rem; font-family: var(--font-display); font-size: 1.05rem; color: var(--brand-light); }
  .tools-note { margin-top: 1.6rem; color: var(--muted); font-size: 0.9rem; }

  .ordering-grid { display: grid; grid-template-columns: 0.72fr 1.28fr; gap: clamp(1.4rem, 3vw, 2.4rem); align-items: stretch; }
  .ordering-photo { margin: 0; position: relative; min-height: 320px; border-radius: 16px; overflow: hidden; border: 1px solid var(--line); }
  .ordering-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 62% 50%; filter: brightness(0.88) saturate(0.9); }
  .ordering-photo::after { content: ""; position: absolute; inset: 0; background: linear-gradient(100deg, rgba(13,14,17,0.85) 0%, rgba(13,14,17,0.25) 38%, rgba(13,14,17,0.05) 60%, rgba(13,14,17,0.4) 100%); pointer-events: none; }
  .ordering-photo figcaption { position: absolute; left: 1rem; bottom: 0.9rem; z-index: 2; font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink); background: rgba(13,14,17,0.72); border-radius: 999px; padding: 0.3rem 0.85rem; backdrop-filter: blur(4px); }
  .ship-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.1rem; align-content: start; }

  .forum-banner {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.4rem;
    border: 1px solid var(--line); border-radius: 20px; padding: clamp(1.6rem, 4vw, 2.4rem);
    background: linear-gradient(120deg, var(--bg-3), var(--bg-2)); margin-top: 2.6rem;
  }
  .forum-banner h3 { font-size: 1.4rem; margin-bottom: 0.3rem; }
  .forum-banner p { color: var(--muted); font-size: 0.95rem; max-width: 560px; }

  .order-form { max-width: 720px; }
  .order-form .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; margin-bottom: 0.9rem; }
  .order-form label { display: block; font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.4rem; }
  .order-form input, .order-form select, .order-form textarea {
    width: 100%; background: var(--bg); border: 1px solid var(--line); border-radius: 12px;
    padding: 0.7rem 1rem; color: var(--ink); font-family: var(--font-body); font-size: 0.95rem;
  }
  .order-form input:focus, .order-form select:focus, .order-form textarea:focus { outline: none; border-color: var(--slate); }
  .order-form textarea { min-height: 130px; resize: vertical; border-radius: 14px; }
  .order-form fieldset { border: 1px solid var(--line); border-radius: 14px; padding: 0.9rem 1.1rem 1rem; margin-bottom: 0.9rem; }
  .order-form legend { font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); padding: 0 0.4rem; }
  .check-row { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; }
  .check-row label { display: inline-flex; align-items: center; gap: 0.5rem; text-transform: none; letter-spacing: 0; font-size: 0.92rem; color: var(--ink); margin: 0; cursor: pointer; }
  .check-row input { width: auto; accent-color: var(--brand); }
  .consent { display: flex; align-items: flex-start; gap: 0.6rem; margin: 0.4rem 0 1.4rem; color: var(--muted); font-size: 0.85rem; }
  .consent input { width: auto; margin-top: 0.3rem; accent-color: var(--brand); }
  .form-fine { margin-top: 1rem; color: var(--muted); font-size: 0.85rem; }

  @media (max-width: 900px) {
    .steel-grid { grid-template-columns: 1fr; }
    .order-form .form-row { grid-template-columns: 1fr; }
    .detail-strip { grid-template-columns: 1fr; }
    .ordering-grid { grid-template-columns: 1fr; }
    .ordering-photo { min-height: 240px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Maker shop page",
  "settings": []
}
{% endschema %}
