<section class="section cart-section full-width">
  <div class="section-head">
    <p class="kicker">Your order</p>
    <h2>Cart</h2>
  </div>

  {%- if cart.item_count == 0 -%}
    <p class="section-sub">Your cart is empty. <a href="{{ routes.all_products_collection_url }}">Browse the shop →</a></p>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-form">
      <div class="cart-lines">
        {%- for item in cart.items -%}
          <div class="cart-line">
            <a class="cart-line-photo" href="{{ item.url }}">
              {%- if item.image -%}
                {{ item.image | image_url: width: 240, height: 240, crop: 'center' | image_tag: loading: 'lazy', alt: item.title }}
              {%- endif -%}
            </a>
            <div class="cart-line-info">
              <a class="cart-line-title" href="{{ item.url }}">{{ item.product.title | remove: ' - 440Hz' | remove: '- 440Hz' | replace: 'Ember Steel', 'Ember Steel®' }}</a>
              {%- for p in item.properties -%}
                {%- unless p.last == blank or p.last == 'No free t-shirt' -%}
                  <p class="cart-line-prop">{{ p.first }}: {{ p.last }}</p>
                {%- endunless -%}
              {%- endfor -%}
              <a class="cart-line-remove" href="{{ item.url_to_remove }}">Remove</a>
            </div>
            <div class="cart-line-qty">
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity of {{ item.title }}">
            </div>
            <p class="cart-line-price">{{ item.final_line_price | money }}</p>
          </div>
        {%- endfor -%}
      </div>

      <div class="cart-summary">
        <div class="cart-summary-row">
          <span>Subtotal</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        <p class="cart-summary-note">Shipping calculated at checkout. Instruments ship fully insured.</p>
        <div class="cart-actions">
          <button type="submit" class="btn btn-ghost">Update cart</button>
          <button type="submit" name="checkout" class="btn btn-primary">Checkout</button>
        </div>
      </div>
    </form>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
