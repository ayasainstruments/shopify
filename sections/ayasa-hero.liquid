<section class="hero full-width" id="top">
  {%- if section.settings.video != blank -%}
    {{ section.settings.video | video_tag: class: 'hero-video', autoplay: true, muted: true, loop: true, playsinline: true, controls: false, image_size: '1600x' }}
  {%- else -%}
    <video class="hero-video" autoplay muted loop playsinline poster="{{ 'hero.jpg' | asset_url }}" aria-hidden="true">
      <source src="{{ 'hero.mp4' | asset_url }}" type="video/mp4">
    </video>
  {%- endif -%}
  <div class="hero-scrim"></div>
  <div class="hero-inner">
    <img class="hero-mark" src="{{ 'logo-512.png' | asset_url }}" alt="{{ shop.name }}" width="116" height="116">
    <p class="kicker">{{ section.settings.kicker }}</p>
    <h1>{{ section.settings.heading | newline_to_br }}</h1>
    <p class="hero-sub">{{ section.settings.subheading }}</p>
    <div class="hero-ctas">
      {%- if section.settings.cta1_label != blank -%}
        <a class="btn btn-primary" href="{{ section.settings.cta1_link | default: '#range' }}">{{ section.settings.cta1_label }}</a>
      {%- endif -%}
      {%- if section.settings.cta2_label != blank -%}
        <a class="btn btn-ghost" href="{{ section.settings.cta2_link | default: '#makers' }}">{{ section.settings.cta2_label }}</a>
      {%- endif -%}
    </div>
  </div>
  <a class="hero-scroll" href="#stats" aria-label="Scroll down">▾</a>
</section>

{% schema %}
{
  "name": "Ayasa hero",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Background video",
      "info": "Leave empty to use the built-in workshop video."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Handmade in the Netherlands · since 2013"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Named for the iron.\nTuned for a lifetime."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Handpans in Ember Steel — full and warm, with a crystal-like upper register. Every instrument shaped by thousands of hammer strikes. No two alike."
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Primary button label",
      "default": "Explore the range"
    },
    {
      "type": "url",
      "id": "cta1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary button label",
      "default": "For makers & partners"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [{ "name": "Ayasa hero" }]
}
{% endschema %}
