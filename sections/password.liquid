{% comment %}
  Landing page shown while the store is password-protected —
  the only page the public sees before launch.
{% endcomment %}

<div class="pw-page full-width">
  <div class="pw-inner">
    <img class="pw-mark" src="{{ 'logo-512.png' | asset_url }}" alt="{{ shop.name }}" width="116" height="116">
    <p class="kicker">{{ section.settings.kicker }}</p>
    <h1>{{ section.settings.heading | newline_to_br }}</h1>
    <p class="pw-sub">
      {%- if shop.password_message != blank -%}
        {{ shop.password_message }}
      {%- else -%}
        {{ section.settings.subheading }}
      {%- endif -%}
    </p>

    {% form 'storefront_password', class: 'pw-form' %}
      {% if form.errors %}
        <p class="option-error">Wrong password — please try again.</p>
      {% endif %}
      <div class="pw-row">
        <input type="password" name="password" id="password-input" placeholder="Password" aria-label="Password" required>
        <button type="submit" class="btn btn-primary">Enter</button>
      </div>
    {% endform %}

    <p class="pw-fine">{{ section.settings.note }}</p>
  </div>
</div>

{% stylesheet %}
  .pw-page {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 2rem 1.5rem;
    background:
      radial-gradient(ellipse 80% 60% at 50% -10%, rgba(101, 117, 153, 0.16), transparent 60%),
      var(--bg);
  }
  .pw-inner { text-align: center; max-width: 520px; }
  .pw-mark { display: block; margin: 0 auto 1.8rem; filter: drop-shadow(0 4px 18px rgba(0, 0, 0, 0.5)); }
  .pw-inner h1 { font-size: clamp(2rem, 5vw, 3.2rem); }
  .pw-sub { color: var(--muted); margin: 1.3rem auto 2rem; font-size: 1rem; }
  .pw-form { margin: 0 auto; max-width: 380px; }
  .pw-row { display: flex; gap: 0.5rem; }
  .pw-row input {
    flex: 1;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.7rem 1.2rem;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.95rem;
  }
  .pw-row input:focus { outline: none; border-color: var(--slate); }
  .pw-row .btn { cursor: pointer; border: 0; font-family: var(--font-body); }
  .pw-fine { margin-top: 2.4rem; color: #6d6b64; font-size: 0.78rem; letter-spacing: 0.08em; }
  @media (max-width: 520px) {
    /* let the headline wrap naturally and stack the form */
    .pw-inner h1 br { display: none; }
    .pw-row { flex-direction: column; gap: 0.6rem; }
    .pw-row .btn { width: 100%; padding: 0.75rem; }
    .pw-row input { text-align: center; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Handmade in the Netherlands · since 2013"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Something is being tuned\nbehind this door."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "info": "Overridden by the password message from Online Store → Preferences, if set.",
      "default": "The new Ayasa Instruments shop is almost ready. If you have a password, come on in."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Fine print",
      "default": "Ayasa Instruments · Almere, the Netherlands"
    }
  ]
}
{% endschema %}
