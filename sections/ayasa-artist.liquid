{%- liquid
  assign artist = section.settings.artist_name | default: page.title
  assign first_name = artist | split: ' ' | first
-%}

<article class="section artist-page full-width">

  <!-- ============ PORTRAIT + INTRO ============ -->
  <div class="artist-hero">
    <figure class="artist-portrait reveal">
      {%- if section.settings.portrait -%}
        {{ section.settings.portrait | image_url: width: 900 | image_tag: widths: '450, 700, 900', alt: section.settings.portrait.alt | default: artist }}
      {%- else -%}
        <img src="{{ 'player-malte.jpg' | asset_url }}" alt="{{ artist }}, handpan artist" width="900" height="900" loading="eager">
      {%- endif -%}
    </figure>
    <div class="artist-intro reveal">
      <p class="kicker">{{ section.settings.kicker }}</p>
      <h1>{{ artist }}</h1>
      <p class="artist-cred">{{ section.settings.credential }}</p>
      {%- if section.settings.link_youtube != blank or section.settings.link_instagram != blank or section.settings.link_web != blank -%}
        <div class="artist-links">
          {%- if section.settings.link_youtube != blank -%}<a href="{{ section.settings.link_youtube }}" target="_blank" rel="noopener">YouTube</a>{%- endif -%}
          {%- if section.settings.link_instagram != blank -%}<a href="{{ section.settings.link_instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
          {%- if section.settings.link_web != blank -%}<a href="{{ section.settings.link_web }}" target="_blank" rel="noopener">Website</a>{%- endif -%}
        </div>
      {%- endif -%}
      <div class="artist-relation">{{ section.settings.relation }}</div>
    </div>
  </div>

  <!-- ============ QUOTE + STORY | INSTRUMENTS ============ -->
  <div class="artist-body">
    <div class="artist-body-text reveal">
      {%- if section.settings.quote != blank -%}
        <figure class="artist-quote">
          <blockquote>“{{ section.settings.quote }}”</blockquote>
          <figcaption>{{ artist }}</figcaption>
        </figure>
      {%- endif -%}
      <div class="artist-story">{{ section.settings.story }}</div>
    </div>
    <aside class="artist-plays reveal">
      <div class="section-head artist-plays-head">
        <p class="kicker">{{ section.settings.plays_kicker }}</p>
        <h2>{{ first_name }} plays</h2>
        <p class="section-sub">{{ section.settings.plays_sub }}</p>
      </div>
      <div class="artist-rail" id="artistPlays" data-artist="{{ artist | escape }}" data-published="{{ section.settings.video_date }}">
        <!-- rendered from ayasa-data.js -->
      </div>
      <button type="button" class="artist-more" id="artistMore" hidden></button>
    </aside>
  </div>

  <!-- ============ LISTENING ROOM ============ -->
  <div class="section-head reveal artist-listen-head">
    <p class="kicker">{{ section.settings.listen_kicker }}</p>
    <h2>{{ section.settings.listen_heading }}</h2>
    <p class="section-sub">{{ section.settings.listen_sub }}</p>
  </div>
  <div class="artist-video-grid reveal" id="artistVideos">
    <!-- rendered from ayasa-data.js -->
  </div>
  <p class="artist-crosslink reveal">{{ section.settings.crosslink_text }} <a href="{{ section.settings.crosslink_url | default: '/#artists' }}">{{ section.settings.crosslink_label }}</a></p>

</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": {{ artist | json }},
  "jobTitle": "Handpan artist",
  "description": {{ section.settings.credential | json }},
  {%- if section.settings.portrait -%}
  "image": {{ section.settings.portrait | image_url: width: 900 | json }},
  {%- else -%}
  "image": {{ 'player-malte.jpg' | asset_url | json }},
  {%- endif -%}
  "url": {{ canonical_url | json }},
  "sameAs": [
    {%- assign same_as = "" -%}
    {%- if section.settings.link_youtube != blank -%}{{ section.settings.link_youtube | json }}{%- assign same_as = "y" -%}{%- endif -%}
    {%- if section.settings.link_instagram != blank -%}{% if same_as != blank %},{% endif %}{{ section.settings.link_instagram | json }}{%- assign same_as = "y" -%}{%- endif -%}
    {%- if section.settings.link_web != blank -%}{% if same_as != blank %},{% endif %}{{ section.settings.link_web | json }}{%- endif -%}
  ],
  "affiliation": { "@type": "Organization", "name": "Ayasa Instruments", "url": {{ shop.url | json }} }
}
</script>

{% stylesheet %}
  .artist-page { padding-top: clamp(7rem, 12vw, 9rem); }
  .artist-hero { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .artist-portrait { margin: 0; }
  .artist-portrait img {
    width: 100%; height: auto; display: block; border-radius: 18px;
    border: 1px solid var(--line);
  }
  .artist-cred { font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--brand-light); margin-top: 0.6rem; }
  .artist-links { display: flex; gap: 0.5rem; margin-top: 1.1rem; flex-wrap: wrap; }
  .artist-links a {
    border: 1px solid var(--line); border-radius: 999px; padding: 0.3rem 0.95rem;
    font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted);
  }
  .artist-links a:hover { color: var(--ink); border-color: var(--slate); }
  .artist-relation { margin-top: 1.8rem; }
  .artist-relation p, .artist-story p { margin-bottom: 1.2rem; color: #c9c6be; }
  .artist-body {
    display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(2rem, 5vw, 5rem);
    align-items: start; margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  .artist-quote {
    border-left: 2px solid; border-image: var(--anneal) 1;
    padding: 0.4rem 0 0.4rem 1.8rem; margin: 0 0 2.2rem;
  }
  .artist-quote blockquote { font-family: var(--font-display); font-style: italic; font-size: 1.35rem; line-height: 1.5; color: var(--ink); }
  .artist-quote figcaption { margin-top: 1.2rem; font-size: 0.75rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--brand-light); }
  .artist-plays-head { margin-bottom: 1.4rem; }
  .artist-plays-head h2 { font-size: clamp(1.5rem, 2.4vw, 1.9rem); }
  .artist-plays-head .section-sub { font-size: 0.9rem; margin-top: 0.6rem; }
  .artist-rail { display: grid; grid-template-columns: 1fr; gap: 0.8rem; }
  .artist-card {
    display: flex; align-items: center; gap: 1rem;
    background: var(--bg-2); border: 1px solid var(--line); border-radius: 14px;
    padding: 0.8rem 1.1rem; color: var(--ink);
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .artist-card:hover { transform: translateY(-2px); border-color: rgba(101, 117, 153, 0.55); color: var(--ink); }
  .artist-card[hidden] { display: none; } /* display:flex above would defeat [hidden] */
  .artist-card-thumb { width: 58px; height: 58px; border-radius: 50%; background: #fff; overflow: hidden; flex: 0 0 auto; }
  .artist-card-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .artist-card-text { flex: 1; min-width: 0; }
  .artist-card-text strong { display: block; font-family: var(--font-display); font-weight: 500; font-size: 1.1rem; }
  .artist-card-text span { font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--brand-light); }
  .artist-card-arrow { font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  .artist-card:hover .artist-card-arrow { color: var(--ink); }
  .artist-card-extra:not([hidden]) { animation: demo-fade-in 0.45s ease; }
  .artist-more {
    margin-top: 0.9rem; background: none; border: 1px solid var(--line); border-radius: 999px;
    color: var(--muted); padding: 0.5rem 1.3rem; cursor: pointer; font-family: var(--font-body);
    font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase;
  }
  .artist-more:hover { color: var(--ink); border-color: var(--slate); }
  .artist-listen-head { margin-top: clamp(3.5rem, 7vw, 5.5rem); }
  /* wall of sound: vertical-scroll grid instead of a side-scroll strip */
  .artist-video-grid {
    display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(230px, 44vw), 1fr));
  }
  .artist-crosslink { margin-top: 2rem; color: var(--muted); }
  @media (max-width: 900px) {
    .artist-hero, .artist-body { grid-template-columns: 1fr; }
    .artist-portrait { max-width: 420px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Artist page",
  "settings": [
    { "type": "text", "id": "artist_name", "label": "Artist name (must match video labels)", "info": "Leave empty to use the page title." },
    { "type": "image_picker", "id": "portrait", "label": "Portrait", "info": "Falls back to the carousel photo when empty." },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Ayasa artist" },
    { "type": "text", "id": "credential", "label": "Credential line", "default": "Handpan artist" },
    { "type": "richtext", "id": "relation", "label": "Relationship to Ayasa" },
    { "type": "text", "id": "quote", "label": "Quote (without quotation marks)" },
    { "type": "richtext", "id": "story", "label": "Story" },
    { "type": "text", "id": "plays_kicker", "label": "Instruments kicker", "default": "The instruments" },
    { "type": "text", "id": "plays_sub", "label": "Instruments subheading", "default": "Tap a card to watch and listen — and follow it into the shop." },
    { "type": "text", "id": "listen_kicker", "label": "Listening room kicker", "default": "The listening room" },
    { "type": "text", "id": "listen_heading", "label": "Listening room heading", "default": "Hear how they play." },
    { "type": "text", "id": "listen_sub", "label": "Listening room subheading", "default": "Pick a scale that speaks to you." },
    { "type": "text", "id": "crosslink_text", "label": "Crosslink text", "default": "Prefer a different voice?" },
    { "type": "text", "id": "crosslink_label", "label": "Crosslink label", "default": "Meet the other Ayasa artists →" },
    { "type": "url", "id": "crosslink_url", "label": "Crosslink URL" },
    { "type": "url", "id": "link_youtube", "label": "YouTube" },
    { "type": "url", "id": "link_instagram", "label": "Instagram" },
    { "type": "url", "id": "link_web", "label": "Website" },
    { "type": "text", "id": "video_date", "label": "Video publish date (YYYY-MM-DD, for structured data)", "default": "2026-01-01" }
  ]
}
{% endschema %}
