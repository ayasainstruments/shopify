<header class="nav full-width" id="nav">
  <a class="nav-logo" href="{{ routes.root_url }}">
    <img src="{{ 'mandala-icon.png' | asset_url }}" alt="" width="30" height="30">
    AYASA<span>·</span>INSTRUMENTS
  </a>
  <nav class="nav-links" id="navLinks">
    {%- if section.settings.menu != blank -%}
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    {%- else -%}
      <a href="/#story">Story</a>
      <a href="/#ember">Ember Steel</a>
      <a href="/#range">The Range</a>
      <a href="/#artists">Artists</a>
      <a href="/#partners">UK Partners</a>
    {%- endif -%}
    <a class="nav-cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label | default: 'Shop' }}</a>
    <a class="nav-cart" href="{{ routes.cart_url }}" aria-label="Cart">
      {{ 'icon-cart.svg' | inline_asset_content }}
      {%- if cart.item_count > 0 -%}<sup>{{ cart.item_count }}</sup>{%- endif -%}
    </a>
  </nav>
  <button class="nav-burger" id="navBurger" aria-label="Open menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</header>

{% stylesheet %}
  .nav-cart {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: var(--muted);
  }
  .nav-cart svg { width: 20px; height: 20px; }
  .nav-cart sup {
    position: absolute;
    top: -6px;
    right: -10px;
    font-size: 0.62rem;
    color: var(--ink);
    background: var(--brand-deep);
    border-radius: 999px;
    padding: 1px 5px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Leave empty to use the default Ayasa links."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ]
}
{% endschema %}
